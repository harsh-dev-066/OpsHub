# Copy to backend/.env and adjust. Never commit the real .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DATABASE_URL=postgres://opshub:opshub@localhost:5433/opshub

# Comma-separated. Only used by prod settings (dev hardcodes localhost).
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5174

JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
LOGIN_THROTTLE_RATE=10/min

# Password given to the seeded demo users by `manage.py seed_demo`.
DEMO_USER_PASSWORD=change-me-demo-password
