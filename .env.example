# Variables read by docker compose (copy to .env at the repo root).

# Password for the seeded demo users (test, priya, chris, sam).
DEMO_USER_PASSWORD=opshub-demo

# Host port for the dev UI (docker-compose.yml). The prod stack uses WEB_PORT too
# (default 8080 there).
# WEB_PORT=5174

# --- docker-compose.prod.yml only -------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# URL-safe characters only (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=
# Load demo data on first start (1) or start empty (0).
SEED_DEMO=1
# ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=http://localhost:8080
