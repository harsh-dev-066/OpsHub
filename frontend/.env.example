# Copy to frontend/.env.local and adjust.

# true  → serve /api/* from the in-browser MSW mock (no backend needed)
# false → call the Django backend (see ../backend/README.md)
VITE_USE_MOCKS=false

# Leave empty in dev: Vite proxies /api to VITE_API_PROXY_TARGET.
# Set to the API origin for production builds hosted separately,
# e.g. https://api.opshub.example.com
VITE_API_BASE_URL=

# Dev proxy target for /api (read by vite.config.ts).
VITE_API_PROXY_TARGET=http://localhost:8000

VITE_ENABLE_QUERY_DEVTOOLS=true
